{
  "name": "rift-pubg-preview",
  "version": "0.2.2",
  "productName": "R i F T",
  "description": "R i F T - PUBG Mobile and GameLoop tuning tool with live hardware telemetry.",
  "author": "R i F T",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite dev --configLoader native",
    "dev:server": "vite dev --configLoader native",
    "community": "node server/community.cjs",
    "community:host": "set RIFT_BIND=0.0.0.0&& set RIFT_PORT=8787&& node server/community.cjs",
    "desktop:dev": "electron .",
    "build": "vite build --configLoader native && tsc --noEmit",
    "preview": "vite preview",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win dir --x64",
    "package:release": "npm run build && electron-builder --win zip --x64 --publish never",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.6.0",
    "electron-builder": "26.15.3",
    "nitro": "^3.0.260311-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "com.rift.alliance",
    "productName": "R i F T",
    "asar": false,
    "npmRebuild": false,
    "electronDist": ".cache/electron-v44.6.0-win32-x64.zip",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "engine/**/*",
      "build/icon.png",
      "build/icon.ico",
      "dist/**/*",
      "package.json",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*.cjs"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "R-i-F-T-${version}-win-${arch}.${ext}"
    }
  },
  "overrides": {
    "@tanstack/start-server-core": "1.169.39"
  }
}
